# Copia este archivo como .env (nix-shell ya lo hace automáticamente si no existe).
# Estos valores coinciden con docker-compose.yml.
DATABASE_URL="postgresql://cc_user:cc_password@localhost:5432/cc_platform"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
PORT=3000
# Detrás de un reverse proxy (Railway/Render/Cloudflare) pon 1 (o el nº de saltos)
# para que el rate-limit y las URLs usen la IP/host reales del cliente.
TRUST_PROXY=1

# ── IA del chat (opcional) ──────────────────────────────────────────────
# Si dejas estas variables vacías, el chat responde con el FALLBACK
# determinístico (respuestas armadas desde el catálogo de la tienda).
# La app nunca se rompe si no hay IA configurada.

# Proveedor GRATUITO para pruebas (console.groq.com → API Keys):
GROQ_API_KEY=""

# Alternativa: usa tu propia key de OpenAI como respaldo.
OPENAI_API_KEY=""

# URL del proveedor OpenAI-compatible. Sirve también para apuntar a tu
# propio servidor autohospedado (Ollama/vLLM). Ver GUIA-IA.md.
AI_BASE_URL="https://api.groq.com/openai/v1"

# Modelo por defecto (Groq). Si lo bajas, consulta modelos en:
#   GET https://api.groq.com/openai/v1/models  (Authorization: Bearer $GROQ_API_KEY)
AI_MODEL="openai/gpt-oss-120b"

# ── Login con Google (DESACTIVADO por ahora) ─────────────────────────────
# El código ya está implementado (src/routes/auth-google.routes.ts +
# frontend/src/components/GoogleAuthButton.tsx), pero la ruta responde 503
# y el botón NO se muestra mientras estas variables estén vacías/ausentes.
# Para activarlo:
#   1. Google Cloud Console → Credenciales → Crear IDs de cliente OAuth
#      (tipo "Aplicación web", origen autorizado http://localhost:5173).
#   2. Pega aquí el Client ID y en frontend/.env con el MISMO valor como
#      VITE_GOOGLE_CLIENT_ID.
#   3. Reinicia backend y frontend.
GOOGLE_CLIENT_ID=""

# ── Wompi (pagos con Nequi) ────────────────────────────────────────────────
# Crea tu cuenta en https://wompi.co → "Panel de comercio" → llaves de desarrollo.
# Para pruebas se usan las llaves con prefijo test_ (WOMPI_SANDBOX=true).
WOMPI_SANDBOX="true"
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_KEY=""
WOMPI_EVENTS_KEY=""
